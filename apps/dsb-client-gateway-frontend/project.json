{
  "root": "apps/dsb-client-gateway-frontend",
  "sourceRoot": "apps/dsb-client-gateway-frontend",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "@nrwl/workspace:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/dsb-client-gateway-frontend"],
      "defaultConfiguration": "production",
      "options": {
        "command": "NODE_ENV=production NX_NEXT_DIST_DIR=../../dist/apps/dsb-client-gateway-frontend/.next next build",
        "cwd": "apps/dsb-client-gateway-frontend"
      },
      "configurations": {
        "production": {}
      }
    },
    "serve": {
      "executor": "@nrwl/workspace:run-commands",
      "options": {
        "command": "next dev -p 4200",
        "cwd": "apps/dsb-client-gateway-frontend"
      },
      "configurations": {
        "production": {
          "command": "next start",
          "cwd": "apps/dsb-client-gateway-frontend"
        }
      }
    },
    "export": {
      "executor": "@nrwl/workspace:run-commands",
      "options": {
        "command": "NODE_ENV=production NX_STATIC_EXPORT=true NX_NEXT_DIST_DIR=../../dist/apps/dsb-client-gateway-frontend/exported next build",
        "cwd": "apps/dsb-client-gateway-frontend"
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["coverage/apps/dsb-client-gateway-frontend"],
      "options": {
        "jestConfig": "apps/dsb-client-gateway-frontend/jest.config.js",
        "passWithNoTests": true
      }
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": [
          "apps/dsb-client-gateway-frontend/src/**/*.{ts,tsx,js,jsx}",
          "apps/dsb-client-gateway-frontend/*.{js,ts}",
          "apps/dsb-client-gateway-frontend/sentry.client.config.js"
        ]
      }
    }
  },
  "tags": []
}
